{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench semantic UI 0.1 \u2014 ADR-004 profile",
  "type": "object",
  "required": [
    "uiVersion",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "uiVersion": {
      "const": "0.1"
    },
    "root": {
      "type": "object",
      "required": [
        "type",
        "title",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "form"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "id",
                  "label",
                  "bind"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "decimal-input"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "bind": {
                    "type": "object",
                    "required": [
                      "direction",
                      "port",
                      "field"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "direction": {
                        "const": "input"
                      },
                      "port": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
                      },
                      "field": {
                        "type": "string",
                        "pattern": "^/(?:[A-Za-z_]|~[01])(?:[A-Za-z0-9_-]|~[01]){0,127}$(?![\\s\\S])"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "id",
                  "label",
                  "bind"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "integer-input"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "bind": {
                    "type": "object",
                    "required": [
                      "direction",
                      "port",
                      "field"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "direction": {
                        "const": "input"
                      },
                      "port": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
                      },
                      "field": {
                        "type": "string",
                        "pattern": "^/(?:[A-Za-z_]|~[01])(?:[A-Za-z0-9_-]|~[01]){0,127}$(?![\\s\\S])"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "id",
                  "label",
                  "bind"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "readout"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "bind": {
                    "type": "object",
                    "required": [
                      "direction",
                      "port",
                      "field"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "direction": {
                        "const": "output"
                      },
                      "port": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
                      },
                      "field": {
                        "type": "string",
                        "pattern": "^/(?:[A-Za-z_]|~[01])(?:[A-Za-z0-9_-]|~[01]){0,127}$(?![\\s\\S])"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$id": "https://workbench.example/schemas/adr-004/0.1/ui.schema.json"
}
