{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.example/schemas/0.1/ui.schema.json",
  "title": "Workbench ui v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uiVersion",
    "root"
  ],
  "properties": {
    "uiVersion": {
      "const": "0.1"
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "form"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "column"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "row"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "bind"
          ],
          "properties": {
            "type": {
              "const": "decimal-input"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "bind"
          ],
          "properties": {
            "type": {
              "const": "integer-input"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "bind",
            "options"
          ],
          "properties": {
            "type": {
              "const": "selector"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "bind"
          ],
          "properties": {
            "type": {
              "const": "button"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "bind"
          ],
          "properties": {
            "type": {
              "const": "readout"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "bind",
            "columns"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "property"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "property": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][A-Za-z0-9]*$"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "bind"
          ],
          "properties": {
            "type": {
              "const": "error-display"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accessibleName": {
              "type": "string",
              "minLength": 1
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            }
          }
        }
      ]
    }
  }
}
