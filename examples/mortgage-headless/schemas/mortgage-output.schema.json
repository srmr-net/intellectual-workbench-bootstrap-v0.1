{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "monthly_payment"
  ],
  "properties": {
    "monthly_payment": {
      "type": "string",
      "maxLength": 13,
      "pattern": "^(?:0|[1-9][0-9]{0,9})\\.[0-9]{2}$(?![\\s\\S])"
    }
  }
}
