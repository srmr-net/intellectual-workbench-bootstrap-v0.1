{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mortgage payment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "monthlyPayment",
    "currency"
  ],
  "properties": {
    "monthlyPayment": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "currency": {
      "const": "GBP"
    }
  }
}
