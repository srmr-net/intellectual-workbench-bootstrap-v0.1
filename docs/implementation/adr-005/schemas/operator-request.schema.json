{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperatorRequestV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestVersion",
    "requestId",
    "utterance",
    "candidates"
  ],
  "properties": {
    "requestVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "utterance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateKey",
          "capability",
          "inputs",
          "hasSemanticUi"
        ],
        "properties": {
          "candidateKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "capability": {
            "type": "string",
            "maxLength": 256
          },
          "inputs": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "hasSemanticUi": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
