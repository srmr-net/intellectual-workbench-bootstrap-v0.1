{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://workbench.example/schema/adr006/provider-profile.v0.1.json",
  "title":"ADR-006 provider profile fixture (not a credential store)",
  "type":"object","additionalProperties":false,
  "required":["profileVersion","provider","model","enabled","remoteConsent","budget"],
  "properties":{
    "profileVersion":{"const":"0.1"},
    "provider":{"enum":["offline-fixture","openai-responses","openrouter-chat"]},
    "model":{"type":"string","minLength":1,"maxLength":120},
    "enabled":{"type":"boolean"},
    "remoteConsent":{"type":"boolean"},
    "budget":{"$ref":"#/$defs/budget"}
  },
  "$defs":{"budget":{"type":"object","additionalProperties":false,"required":["timeoutMs","maxOutputTokens","maxRequestBytes","maxResponseBytes","maxCatalogCandidates","maxCalls"],"properties":{
    "timeoutMs":{"type":"integer","minimum":1000,"maximum":45000},
    "maxOutputTokens":{"type":"integer","minimum":1,"maximum":1024},
    "maxRequestBytes":{"type":"integer","minimum":1,"maximum":8192},
    "maxResponseBytes":{"type":"integer","minimum":1,"maximum":32768},
    "maxCatalogCandidates":{"type":"integer","minimum":1,"maximum":16},
    "maxCalls":{"type":"integer","minimum":1,"maximum":3}
  }}}
}
