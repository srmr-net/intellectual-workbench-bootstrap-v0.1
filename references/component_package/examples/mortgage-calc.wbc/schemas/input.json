{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mortgage terms",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principal",
    "annualRate",
    "termMonths"
  ],
  "properties": {
    "principal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
    },
    "annualRate": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "termMonths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  }
}
